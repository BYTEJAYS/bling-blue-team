# Blue Team — Docker Compose overrides
# Loaded by: transaction-graph-intelligence/docker-compose.yml
# Host values (localhost) are overridden by the compose environment: block.

# PostgreSQL — overridden per-service in compose
POSTGRES_URL=postgresql://bling_user:bling_secret@blue-postgres:5432/bling_blue
POSTGRES_USER=bling_user
POSTGRES_PASSWORD=bling_secret
POSTGRES_DB=bling_blue

# Neo4j — not used by Blue Team API endpoints, safe to stub
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Redis — share TGI's Redis instance
REDIS_URL=redis://tgie-redis:6379

# API Keys — must match what TGI backend sends as x-api-key
GRAPH_ENGINE_API_KEY=changeme-graph-engine-key
INVESTIGATOR_API_KEY=changeme-investigator-key
INTERNAL_API_KEY=changeme-internal-key-never-use-in-prod

# Integrations (stubbed — teammates not required for graph analysis)
BLOCKCHAIN_SERVICE_URL=http://localhost:8001
RED_TEAM_SERVICE_URL=http://localhost:8002
INVESTIGATOR_DASHBOARD_URL=http://localhost:8003

# PII salt
SALT=docker-compose-salt-change-in-prod

# Model version
MODEL_VERSION=v1.0

# Debug
DEBUG=false
